{
  "name": "ScanForge",
  "short_name": "ScanForge",
  "description": "Scanner di documenti: trasforma le foto in PDF puliti, anche offline",
  "lang": "it",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
